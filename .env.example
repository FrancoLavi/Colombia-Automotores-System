# Copiar a .env.local y completar.
# Sin DATABASE_URL se usa PGlite local en ./.data/pglite

# En producción, la cadena de Supabase. IMPORTANTE: tiene que ser la del
# "Session pooler" (puerto 5432), NO la del "Transaction pooler" (6543).
# Con el transaction pooler la app no falla: se queda colgada. La app manda varias
# consultas encadenadas por la misma conexión y ese pooler las parte al medio, así que
# el servidor espera un cierre que nunca llega. El síntoma son pantallas que cargan
# para siempre y, en la base, consultas triviales "activas" durante minutos.
# El límite de una conexión por instancia que hace falta para que el session pooler
# alcance está puesto en src/db/index.ts.
# Para migrar a mano (scripts/migrate.ts) también va el 5432.
DATABASE_URL=

SESSION_SECRET=cambiar-por-una-cadena-larga-aleatoria

# Solo los usa scripts/seed.ts para crear el usuario inicial. No hacen falta en Vercel.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NOMBRE=
SEED_ADMIN_PASSWORD=
SEED_INVERSORES=

# Almacenamiento de fotos y documentos en producción (Supabase Storage).
# Sin estas tres, los archivos van a disco local en ./.data/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=archivos
